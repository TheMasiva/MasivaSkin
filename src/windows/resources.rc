101 ICON "asuna.ico"
1 24 "app.manifest"
201 RCDATA "fonts/Oxanium-ExtraBold.ttf"
202 RCDATA "fonts/Rajdhani-Medium.ttf"
// Minimal Win32 dialog constants keep the resource compiler independent of SDK include paths.
#define DS_SETFONT 0x40
#define DS_CENTER 0x800
#define WS_POPUP 0x80000000
#define WS_SYSMENU 0x80000
#define WS_CLIPCHILDREN 0x02000000
#define WS_EX_APPWINDOW 0x40000
#define SS_OWNERDRAW 0x0d
#define BS_OWNERDRAW 0x0b
#define WS_TABSTOP 0x10000
#define IDOK 1
#include "launch_ids.h"
IDI_LAUNCH_STEAM ICON "steam.ico"

IDB_LAUNCH_ART BITMAP "asuna-hero.bmp"

IDD_CS2_LAUNCH DIALOGEX 0,0,452,224
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Discord settings", IDC_LAUNCH_RPC, "Button", BS_OWNERDRAW | WS_TABSTOP, 201,11,20,18
    CONTROL "Asuna", IDC_LAUNCH_PORTRAIT, "Static", SS_OWNERDRAW, 0,0,180,224
    CONTROL "", IDC_RELEASE_LABEL, "Static", SS_OWNERDRAW, 225,11,165,18
    CONTROL "Minimize", IDC_LAUNCH_MINIMIZE, "Button", BS_OWNERDRAW | WS_TABSTOP, 402,11,18,18
    CONTROL "Close", 2, "Button", BS_OWNERDRAW | WS_TABSTOP, 426,11,18,18
    CONTROL "MASIVA SKIN", IDC_LAUNCH_BRAND, "Static", SS_OWNERDRAW, 201,66,237,36
    CONTROL "Launch CS2", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 201,116,217,33
    CONTROL "Explore menu", IDC_LAUNCH_PREVIEW, "Button", BS_OWNERDRAW | WS_TABSTOP, 201,160,217,30
END

IDD_RPC DIALOGEX 0,0,190,40
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_SYSMENU | 0x00c00000
CAPTION "Discord Rich Presence"
FONT 10, "Segoe UI"
BEGIN
    CONTROL "Discord Rich Presence", IDC_RPC_ENABLE, "Button", BS_OWNERDRAW | WS_TABSTOP, 7,6,176,28
END
